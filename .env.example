# Copy this file to .env for local testing, or add the same names
# in Vercel under Project Settings > Environment Variables.

# You need ONE of the two keys below.

# FREE option: Google Gemini. Create a key in Google AI Studio (aistudio.google.com),
# under "Get API key". If this is set it is used first.
GEMINI_API_KEY=
# Optional model name. The default is a small, fast model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Paid option: OpenAI. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Force one provider when both keys are set: "gemini" or "openai".
AI_PROVIDER=

# Optional. Any chat-capable OpenAI model your account can use.
# A small, cheap model is enough for 3-sentence reviews.
OPENAI_MODEL=gpt-4o-mini

# Optional. Max drafts per visitor (by IP) in a 10 minute window.
RATE_LIMIT_MAX=8
